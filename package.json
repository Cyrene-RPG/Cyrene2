{
  "name": "cyrene",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "app:dev": "vite",
    "dist:win": "npm run build && electron-builder --win",
    "dist:win:beta": "cross-env CYRENE_UPDATE_CHANNEL=beta npm run build && cross-env CYRENE_UPDATE_CHANNEL=beta electron-builder --win --config.publish.channel=beta --config.publish.releaseType=prerelease",
    "publish:win": "npm run build && electron-builder --win --publish always",
    "publish:win:beta": "cross-env CYRENE_UPDATE_CHANNEL=beta npm run build && cross-env CYRENE_UPDATE_CHANNEL=beta electron-builder --win --publish always --config.publish.channel=beta --config.publish.releaseType=prerelease"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^36.5.0",
    "electron-builder": "^26.0.12",
    "cross-env": "^7.0.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0"
  },
  "build": {
    "appId": "com.cyrene.rpg",
    "productName": "Cyrene",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/favicon.png"
    ],
    "publish": {
      "provider": "github",
      "owner": "Cyrene-RPG",
      "repo": "Cyrene2"
    },
    "generateUpdatesFilesForAllChannels": true,
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
